# Trip Agent Backend — Environment Configuration Template
# Copy this file to .env and supply actual values for your deployment.

# Server Environment
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or local)
# Example for Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Example for local: mongodb://localhost:27017/trip-agent
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/trip-agent?retryWrites=true&w=majority

# Frontend URL for CORS (Vercel deployment URL or comma-separated list of allowed origins)
FRONTEND_URL=https://your-trip-agent.vercel.app

# Optional Backward-Compatible CORS Origin
CORS_ORIGIN=https://your-trip-agent.vercel.app

# AI / LLM Orchestration Configuration
# Options: mock | gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
