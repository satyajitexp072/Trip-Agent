# Trip Agent Frontend — Environment Configuration Template
# Copy this file to .env or .env.production and supply your backend API URL.

# For Local Development (when using Vite proxy):
# VITE_API_URL=/api
# or direct local backend:
# VITE_API_URL=http://localhost:5000/api

# For Production (Render / Deployed Backend URL):
VITE_API_URL=https://your-trip-agent-backend.onrender.com/api

